+static bool
+mouse_in_vertical_tab_bar_resize_handle(const OSWindow *osw) {
+    if (!osw || !OPT(vertical_tab_bar_resize) || OPT(tab_bar_hidden) || osw->has_too_few_tabs) return false;
+    if (OPT(tab_bar_edge) != LEFT_EDGE && OPT(tab_bar_edge) != RIGHT_EDGE) return false;
+    Region central = {0}, tab_bar = {0};
+    os_window_regions(osw, &central, &tab_bar);
+    if (osw->mouse_y < tab_bar.top || osw->mouse_y >= tab_bar.bottom) return false;
+    // Keep the complete hit target on the tab-bar side of the divider. This
+    // makes terminal cells adjacent to the divider behave exactly as before.
+    double dpi = osw->fonts_data ? (osw->fonts_data->logical_dpi_x + osw->fonts_data->logical_dpi_y) / 2. : 72.;
+    double hit_width = MAX(3., round(5. * dpi / 72.));
+    // central is the actual visible divider. It includes the inner margin,
+    // unlike tab_bar.right/left. Stay strictly on the sidebar side of it.
+    if (OPT(tab_bar_edge) == LEFT_EDGE)
+        return osw->mouse_x >= MAX((double)tab_bar.left, (double)central.left - hit_width) && osw->mouse_x < central.left;
+    return osw->mouse_x >= central.right && osw->mouse_x < MIN((double)tab_bar.right, (double)central.right + hit_width);
+}
